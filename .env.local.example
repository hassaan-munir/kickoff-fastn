# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to write onboarding results. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fastn (server only)
# API key from the Fastn dashboard: Settings > API keys > Create key.
# Test-mode keys (fsk_test_...) work too; the server adds the X-fastn-Test-Mode header for them.
FASTN_API_KEY=
# The API origin your Fastn dashboard calls, for example https://api.fastn.dev
FASTN_BASE_URL=
# Workflow slug or id of the onboarding workflow in Fastn, for example client-onboarding
FASTN_WORKFLOW_ID=
# Optional. "test" runs the latest published version, "live" runs the version deployed to Live.
# Leave empty to use the mode of the API key.
FASTN_ENV=

# Fastn (browser). Same origin as FASTN_BASE_URL. Optional when you use the default https://api.fastn.dev
NEXT_PUBLIC_FASTN_BASE_URL=
